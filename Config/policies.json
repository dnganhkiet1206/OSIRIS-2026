{
  "storeWriteGate": {
    "requiresAnyOf": ["reusableLater", "affectsArchitecture", "reducesFutureTokens"]
  },
  "approvalRequired": [
    "publish",
    "delete",
    "overwrite",
    "largeSpend",
    "permanentSettingsChange",
    "coreBehaviorChange"
  ],
  "workingContextDefaultTTLHours": 24,
  "aiRetry": {
    "maxAttempts": 2
  }
}
